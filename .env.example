# Environment variables read by jiraACP. Copy to .env and fill in locally.
# The CLI does not load .env automatically — export these in your shell
# (e.g. `set -a; source .env; set +a`) or set them in your MCP client config.
#
# Pipeline credentials (Jira, GitHub, Telegram) live in the per-project config
# at ~/.jira-acp/projects/<name>.json, created by `jiraACP init`.

# Claude API key, forwarded to the Claude Code subprocess (src/utils/process.ts)
ANTHROPIC_API_KEY=

# Log level for the pino logger: trace | debug | info | warn | error
LOG_LEVEL=info

# Shared secret for verifying Jira webhooks in `jiraACP serve` (src/commands/serve.ts)
JIRA_ACP_WEBHOOK_SECRET=

# Jira instances for the MCP server and the `sprint` / `triage` commands
# (src/integrations/jira/client.ts). Pattern: JIRA_<NAME>_URL / _EMAIL / _TOKEN.
# Repeat the block with a different <NAME> for each instance.
JIRA_MAIN_URL=https://your-domain.atlassian.net
JIRA_MAIN_EMAIL=
JIRA_MAIN_TOKEN=
